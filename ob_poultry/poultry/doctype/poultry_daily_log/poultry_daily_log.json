{
    "doctype": "DocType",
    "name": "Poultry Daily Log",
    "module": "Poultry",
    "engine": "InnoDB",
    "autoname": "format:PDL-{YYYY}-{#####}",
    "naming_rule": "Expression (old style)",
    "is_submittable": 1,
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "batch",
            "fieldtype": "Link",
            "label": "Batch",
            "options": "Poultry Batch",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "log_date",
            "fieldtype": "Date",
            "label": "Log Date",
            "default": "Today",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_log_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "average_body_weight_g",
            "fieldtype": "Float",
            "label": "Average Body Weight (g)"
        },
        {
            "fieldname": "std_body_weight_g",
            "fieldtype": "Float",
            "label": "Standard Body Weight (g)",
            "read_only": 1
        },
        {
            "fieldname": "section_break_log_birds",
            "fieldtype": "Section Break",
            "label": "Birds"
        },
        {
            "fieldname": "mortality_details",
            "fieldtype": "Table",
            "label": "Mortality Detail",
            "options": "Poultry Daily Log Mortality Entry"
        },
        {
            "fieldname": "mortality_count",
            "fieldtype": "Int",
            "label": "Mortality Count",
            "default": "0",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_log_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "cull_count",
            "fieldtype": "Int",
            "label": "Cull Count",
            "default": "0"
        },
        {
            "fieldname": "std_mortality_pct",
            "fieldtype": "Percent",
            "label": "Standard Mortality %",
            "read_only": 1
        },
        {
            "fieldname": "section_break_log_feed",
            "fieldtype": "Section Break",
            "label": "Feed & Water"
        },
        {
            "fieldname": "feed_item",
            "fieldtype": "Link",
            "label": "Feed Item",
            "options": "Item"
        },
        {
            "fieldname": "feed_consumed_kg",
            "fieldtype": "Float",
            "label": "Feed Consumed (kg)",
            "in_list_view": 1
        },
        {
            "fieldname": "stock_entry",
            "fieldtype": "Link",
            "label": "Stock Entry",
            "options": "Stock Entry",
            "read_only": 1
        },
        {
            "fieldname": "std_feed_per_bird_g",
            "fieldtype": "Float",
            "label": "Standard Feed / Bird (g)",
            "read_only": 1
        },
        {
            "fieldname": "column_break_log_3",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "water_consumed_liters",
            "fieldtype": "Float",
            "label": "Water Consumed (liters)"
        },
        {
            "fieldname": "section_break_log_production",
            "fieldtype": "Section Break",
            "label": "Egg Production"
        },
        {
            "fieldname": "egg_entries",
            "fieldtype": "Table",
            "label": "Egg Entries",
            "options": "Poultry Daily Log Egg Entry"
        },
        {
            "fieldname": "total_eggs_produced",
            "fieldtype": "Int",
            "label": "Total Eggs Produced",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_log_4",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "hdep_percent",
            "fieldtype": "Percent",
            "label": "HDEP %",
            "read_only": 1
        },
        {
            "fieldname": "egg_count",
            "fieldtype": "Int",
            "label": "Eggs Collected (Deprecated)",
            "read_only": 1,
            "description": "Superseded by Egg Entries above; kept read-only for historical rows."
        },
        {
            "fieldname": "notes",
            "fieldtype": "Small Text",
            "label": "Notes"
        }
    ],
    "sort_field": "log_date",
    "sort_order": "DESC",
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        },
        {
            "role": "Poultry Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        },
        {
            "role": "Poultry Attendant",
            "read": 1,
            "write": 1,
            "create": 1,
            "submit": 1
        }
    ]
}
