{
    "doctype": "DocType",
    "name": "Poultry Chick Transfer",
    "module": "Poultry",
    "engine": "InnoDB",
    "autoname": "format:CHTR-{YYYY}-{#####}",
    "naming_rule": "Expression (old style)",
    "is_submittable": 1,
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "hatch",
            "fieldtype": "Link",
            "label": "Hatch",
            "options": "Poultry Hatch",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "batch",
            "fieldtype": "Link",
            "label": "Batch",
            "options": "Poultry Batch",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_chtr_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "transfer_date",
            "fieldtype": "Date",
            "label": "Transfer Date",
            "default": "Today",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "quantity",
            "fieldtype": "Int",
            "label": "Quantity",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "notes",
            "fieldtype": "Small Text",
            "label": "Notes"
        }
    ],
    "sort_field": "transfer_date",
    "sort_order": "DESC",
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        },
        {
            "role": "Poultry Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        }
    ]
}
