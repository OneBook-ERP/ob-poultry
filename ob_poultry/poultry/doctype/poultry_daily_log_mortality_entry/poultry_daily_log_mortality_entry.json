{
    "doctype": "DocType",
    "name": "Poultry Daily Log Mortality Entry",
    "module": "Poultry",
    "engine": "InnoDB",
    "istable": 1,
    "fields": [
        {
            "fieldname": "cause",
            "fieldtype": "Select",
            "label": "Cause",
            "options": "Disease\nInjury\nHeat Stress\nCulled (Runt or Weak)\nPredator\nUnknown\nOther",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "sex",
            "fieldtype": "Select",
            "label": "Sex",
            "options": "Unspecified\nMale\nFemale",
            "default": "Unspecified",
            "in_list_view": 1
        },
        {
            "fieldname": "count",
            "fieldtype": "Int",
            "label": "Count",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "description",
            "fieldtype": "Small Text",
            "label": "Description"
        },
        {
            "fieldname": "photo",
            "fieldtype": "Attach Image",
            "label": "Photo"
        }
    ]
}
