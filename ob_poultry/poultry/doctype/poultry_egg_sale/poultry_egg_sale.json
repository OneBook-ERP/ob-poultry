{
    "doctype": "DocType",
    "name": "Poultry Egg Sale",
    "module": "Poultry",
    "engine": "InnoDB",
    "autoname": "format:PES-{YYYY}-{#####}",
    "naming_rule": "Expression (old style)",
    "is_submittable": 1,
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "batch",
            "fieldtype": "Link",
            "label": "Batch",
            "options": "Poultry Batch",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "customer",
            "fieldtype": "Link",
            "label": "Customer",
            "options": "Customer",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_pes_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "sale_date",
            "fieldtype": "Date",
            "label": "Sale Date",
            "default": "Today",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "total_amount",
            "fieldtype": "Currency",
            "label": "Total Amount",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "section_break_pes_2",
            "fieldtype": "Section Break",
            "label": "Items"
        },
        {
            "fieldname": "items",
            "fieldtype": "Table",
            "label": "Items",
            "options": "Poultry Egg Sale Item",
            "reqd": 1
        }
    ],
    "sort_field": "sale_date",
    "sort_order": "DESC",
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        },
        {
            "role": "Poultry Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        }
    ]
}
