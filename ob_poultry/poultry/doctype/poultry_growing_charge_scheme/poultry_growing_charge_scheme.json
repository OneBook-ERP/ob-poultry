{
    "doctype": "DocType",
    "name": "Poultry Growing Charge Scheme",
    "module": "Poultry",
    "engine": "InnoDB",
    "autoname": "field:scheme_name",
    "fields": [
        {
            "fieldname": "scheme_name",
            "fieldtype": "Data",
            "label": "Scheme Name",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "is_active",
            "fieldtype": "Check",
            "label": "Is Active",
            "default": "1",
            "in_list_view": 1
        },
        {
            "fieldname": "description",
            "fieldtype": "Small Text",
            "label": "Description"
        },
        {
            "fieldname": "section_break_scheme_rates",
            "fieldtype": "Section Break",
            "label": "Rate Brackets"
        },
        {
            "fieldname": "rates",
            "fieldtype": "Table",
            "label": "Rate Brackets",
            "options": "Poultry Growing Charge Rate",
            "reqd": 1
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Poultry Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        }
    ]
}
