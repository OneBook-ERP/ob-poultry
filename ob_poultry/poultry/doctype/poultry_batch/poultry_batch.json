{
    "doctype": "DocType",
    "name": "Poultry Batch",
    "module": "Poultry",
    "engine": "InnoDB",
    "autoname": "format:PB-{YYYY}-{#####}",
    "naming_rule": "Expression (old style)",
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "shed",
            "fieldtype": "Link",
            "label": "Shed",
            "options": "Poultry Shed",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "breed",
            "fieldtype": "Link",
            "label": "Breed",
            "options": "Poultry Breed",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "breed_type",
            "fieldtype": "Select",
            "label": "Breed Type",
            "options": "Broiler\nLayer\nBreeder\nDual Purpose",
            "fetch_from": "breed.breed_type",
            "read_only": 1
        },
        {
            "fieldname": "column_break_batch_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "start_date",
            "fieldtype": "Date",
            "label": "Start Date",
            "default": "Today",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Active\nClosed",
            "default": "Active",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "end_date",
            "fieldtype": "Date",
            "label": "End Date",
            "read_only": 1
        },
        {
            "fieldname": "section_break_batch_counts",
            "fieldtype": "Section Break",
            "label": "Bird Count"
        },
        {
            "fieldname": "initial_bird_count",
            "fieldtype": "Int",
            "label": "Initial Bird Count",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_batch_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "current_bird_count",
            "fieldtype": "Int",
            "label": "Current Bird Count",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "total_mortality",
            "fieldtype": "Int",
            "label": "Total Mortality",
            "read_only": 1
        },
        {
            "fieldname": "section_break_batch_feed",
            "fieldtype": "Section Break",
            "label": "Feed"
        },
        {
            "fieldname": "feed_warehouse",
            "fieldtype": "Link",
            "label": "Feed Warehouse",
            "options": "Warehouse",
            "description": "Warehouse that feed stock is issued from when logging daily feed consumption"
        },
        {
            "fieldname": "cumulative_feed_kg",
            "fieldtype": "Float",
            "label": "Cumulative Feed (kg)",
            "read_only": 1
        },
        {
            "fieldname": "column_break_batch_3",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "fcr",
            "fieldtype": "Float",
            "label": "FCR",
            "read_only": 1,
            "precision": "3",
            "default": "0"
        },
        {
            "fieldname": "cfcr",
            "fieldtype": "Float",
            "label": "CFCR",
            "read_only": 1,
            "precision": "3",
            "default": "0",
            "description": "Mortality-corrected FCR. Uses the batch's latest recorded average body weight to value mortality weight — an approximation; confirm the formula with farm operations before using it for any payout calculation."
        },
        {
            "fieldname": "section_break_batch_sexed",
            "fieldtype": "Section Break",
            "label": "Sexed Count",
            "collapsible": 1,
            "description": "Optional breakdown for breeder flocks; initial_bird_count remains the total."
        },
        {
            "fieldname": "male_bird_count",
            "fieldtype": "Int",
            "label": "Male Bird Count"
        },
        {
            "fieldname": "column_break_batch_4",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "female_bird_count",
            "fieldtype": "Int",
            "label": "Female Bird Count"
        },
        {
            "fieldname": "section_break_batch_contract",
            "fieldtype": "Section Break",
            "label": "Contract Farming",
            "collapsible": 1
        },
        {
            "fieldname": "flock_source",
            "fieldtype": "Select",
            "label": "Flock Source",
            "options": "Owned\nContract",
            "default": "Owned",
            "in_list_view": 1
        },
        {
            "fieldname": "farmer",
            "fieldtype": "Link",
            "label": "Farmer",
            "options": "Poultry Farmer",
            "depends_on": "eval:doc.flock_source=='Contract'"
        },
        {
            "fieldname": "column_break_batch_5",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "growing_charge_scheme",
            "fieldtype": "Link",
            "label": "Growing Charge Scheme",
            "options": "Poultry Growing Charge Scheme",
            "depends_on": "eval:doc.flock_source=='Contract'"
        },
        {
            "fieldname": "growing_charge_amount",
            "fieldtype": "Currency",
            "label": "Growing Charge Amount",
            "read_only": 1,
            "depends_on": "eval:doc.flock_source=='Contract'"
        },
        {
            "fieldname": "section_break_batch_source",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "source",
            "fieldtype": "Data",
            "label": "Source / Hatchery"
        },
        {
            "fieldname": "notes",
            "fieldtype": "Small Text",
            "label": "Notes"
        }
    ],
    "sort_field": "creation",
    "sort_order": "DESC",
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Poultry Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Poultry Attendant",
            "read": 1
        },
        {
            "role": "Vaccination In-charge",
            "read": 1
        },
        {
            "role": "Feed Mill Operator",
            "read": 1
        }
    ]
}
