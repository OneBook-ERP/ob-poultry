{
    "doctype": "DocType",
    "name": "Poultry Hatch",
    "module": "Poultry",
    "engine": "InnoDB",
    "autoname": "format:HTCH-{YYYY}-{#####}",
    "naming_rule": "Expression (old style)",
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "hatchery",
            "fieldtype": "Link",
            "label": "Hatchery",
            "options": "Poultry Hatchery",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "breed_type",
            "fieldtype": "Select",
            "label": "Breed Type",
            "options": "\nBroiler\nLayer\nBreeder\nDual Purpose",
            "fetch_from": "hatchery.breed_type",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "breed",
            "fieldtype": "Link",
            "label": "Breed",
            "options": "Poultry Breed",
            "in_list_view": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Scheduled\nSetting\nHatching\nClosed",
            "default": "Scheduled",
            "in_list_view": 1
        },
        {
            "fieldname": "column_break_hatch_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "schedule_date",
            "fieldtype": "Date",
            "label": "Schedule Date",
            "default": "Today",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "setting_date",
            "fieldtype": "Date",
            "label": "Setting Date"
        },
        {
            "fieldname": "initial_egg_count",
            "fieldtype": "Int",
            "label": "Initial Egg Count",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "initial_bird_count",
            "fieldtype": "Int",
            "label": "Initial Bird Count",
            "in_list_view": 1
        },
        {
            "fieldname": "section_break_hatch_dates",
            "fieldtype": "Section Break",
            "label": "Incubation"
        },
        {
            "fieldname": "candling_date",
            "fieldtype": "Date",
            "label": "Candling Date"
        },
        {
            "fieldname": "transfer_date",
            "fieldtype": "Date",
            "label": "Transfer Date"
        },
        {
            "fieldname": "column_break_hatch_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "hatch_date",
            "fieldtype": "Date",
            "label": "Hatch Date"
        },
        {
            "fieldname": "section_break_transfer",
            "fieldtype": "Section Break",
            "label": "Chick Transfer Details",
            "depends_on": "eval:doc.transferred_batch"
        },
        {
            "fieldname": "transferred_batch",
            "fieldtype": "Link",
            "label": "Transferred Batch",
            "options": "Poultry Batch",
            "read_only": 1
        },
        {
            "fieldname": "column_break_transfer_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "transferred_chicks",
            "fieldtype": "Int",
            "label": "Transferred Chicks",
            "read_only": 1
        },
        {
            "fieldname": "section_break_notes",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "notes",
            "fieldtype": "Small Text",
            "label": "Notes"
        },
        {
            "fieldname": "eggs_set",
            "fieldtype": "Int",
            "label": "Eggs Set",
            "hidden": 1
        },
        {
            "fieldname": "actual_chicks",
            "fieldtype": "Int",
            "label": "Actual Chicks",
            "hidden": 1
        }
    ],
    "sort_field": "schedule_date",
    "sort_order": "DESC",
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Poultry Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        }
    ]
}